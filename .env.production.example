# NovaScale production environment template.
# Copy to .env.production and replace every CHANGE_ME value before deployment.
# Never commit .env.production.

APP_NAME=NovaScale API
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# FastAPI host validation. Pydantic parses JSON arrays from environment values.
ALLOWED_HOSTS=["api.example.com","backend"]
CORS_ALLOWED_ORIGINS=[]

# PostgreSQL administrator/migration role.
POSTGRES_DB=novascale
POSTGRES_USER=novascale
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# Least-privilege runtime role created by docker/postgres/init/01-create-runtime-role.sh.
APP_DB_USER=novascale_app
APP_DB_PASSWORD=CHANGE_ME_STRONG_RUNTIME_DB_PASSWORD

# Keep credentials URL-encoded if they contain reserved URL characters.
DATABASE_URL=postgresql+asyncpg://novascale_app:CHANGE_ME_STRONG_RUNTIME_DB_PASSWORD@postgres:5432/novascale
MIGRATION_DATABASE_URL=postgresql+asyncpg://novascale:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/novascale

AUTH_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
AUTH_JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=novascale
JWT_AUDIENCE=novascale-api
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Only addresses/networks of the trusted reverse proxy may appear here.
# For a host reverse proxy reaching the loopback-published frontend, the backend
# itself normally receives traffic only from the internal Next.js service.
FORWARDED_ALLOW_IPS=127.0.0.1

# Frontend is bound to host loopback so a host reverse proxy can publish HTTPS.
FRONTEND_PORT=3000

# AI remains optional for the portfolio MVP. Configure Ollama only when the
# deployment host has sufficient memory/compute and the backend can reach it.
AI_LLM_PROVIDER=ollama
AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_OLLAMA_MODEL=qwen2.5:3b
AI_OLLAMA_TIMEOUT_SECONDS=360
AI_EMBEDDING_PROVIDER=ollama
AI_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_DOCUMENT_STORAGE_ROOT=./storage
