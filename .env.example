APP_NAME=NovaScale API
APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

POSTGRES_DB=novascale
POSTGRES_USER=novascale
POSTGRES_PASSWORD=novascale_local_change_me
DATABASE_URL=postgresql+asyncpg://novascale:novascale_local_change_me@postgres:5432/novascale

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

AUTH_JWT_SECRET=replace_with_a_strong_random_secret
AUTH_JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=novascale
JWT_AUDIENCE=novascale-api
