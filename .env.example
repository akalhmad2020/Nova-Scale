APP_NAME=NovaScale API
APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
CORS_ALLOWED_ORIGINS=[]
HSTS_ENABLED=false
FORWARDED_ALLOW_IPS=127.0.0.1

POSTGRES_DB=novascale
POSTGRES_USER=novascale
POSTGRES_PASSWORD=novascale_local_change_me
DATABASE_URL=postgresql+asyncpg://novascale:novascale_local_change_me@postgres:5432/novascale

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_COMMAND_TIMEOUT_SECONDS=30


AUTH_JWT_SECRET=replace_with_a_strong_random_secret
AUTH_JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=novascale
JWT_AUDIENCE=novascale-api
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

OUTBOX_WORKER_POLL_INTERVAL_SECONDS=2
OUTBOX_WORKER_BATCH_SIZE=50
OUTBOX_WORKER_MAX_ATTEMPTS=5
OUTBOX_WORKER_RETRY_BASE_SECONDS=30
OUTBOX_WORKER_RETRY_MAX_SECONDS=900
OUTBOX_WORKER_LEASE_SECONDS=300

NOTIFICATION_WORKER_POLL_INTERVAL_SECONDS=2
NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_WORKER_MAX_ATTEMPTS=3
NOTIFICATION_WORKER_RETRY_BASE_SECONDS=30
NOTIFICATION_WORKER_RETRY_MAX_SECONDS=900

AI_LLM_PROVIDER=ollama
AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_OLLAMA_MODEL=qwen2.5:3b
AI_OLLAMA_TIMEOUT_SECONDS=180
AI_EMBEDDING_PROVIDER=ollama
AI_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_DOCUMENT_STORAGE_ROOT=./storage
